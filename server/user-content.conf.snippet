# ---------------------------------------------------------------------------
# User-content host (files.example.com): make user content inert (P0 + P1)
#
# Put this inside <VirtualHost *:443> in
#   the user-content host's SSL vhost (e.g. files.example.com-le-ssl.conf)
# replacing the existing <Directory "/var/www/files.example.com"> block, then:
#   sudo a2enmod headers && sudo apache2ctl configtest && sudo systemctl reload apache2
# ---------------------------------------------------------------------------

<Directory "/var/www/files.example.com">
    # Listings stay; symlinks only when owner matches (no links into /etc etc.).
    Options Indexes SymLinksIfOwnerMatch
    AllowOverride None
    Require all granted

    # P0: no server-side code at all.
    php_admin_flag engine off
    # Blocked outright: with only "engine off" the source code would be served.
    <FilesMatch "\.(?i:php\d?|phtml|pht|phar|phps|inc|cgi|fcgi|pl|py|rb|sh|asp|aspx|jsp)$">
        Require all denied
    </FilesMatch>
    Options -ExecCGI -Includes

    # No user-made web pages. A folder's index.html is not shown as its
    # page: visitors get the file listing.
    DirectoryIndex disabled

    # HTML files opened directly are shown as plain text, not rendered.
    # Exception: HEADER.html/README.html (Page design, inserted into
    # listings by mod_autoindex).
    <If "%{REQUEST_FILENAME} =~ m#\.(?i:x?html?|shtml?|mht(?:ml)?)$# && ! %{REQUEST_FILENAME} =~ m#/(?:HEADER|README)\.html$#">
        ForceType text/plain
    </If>
</Directory>

# P1: pages on this host may show anything but run nothing.
# Only for document types, so PDFs, images and media are unaffected.
Header set Content-Security-Policy "default-src 'none'; img-src * data:; media-src *; style-src * 'unsafe-inline'; font-src * data:; form-action 'none'; frame-ancestors 'none'; base-uri 'self'" "expr=%{CONTENT_TYPE} =~ m#^(text/html|application/xhtml|image/svg|text/xml|application/xml)#"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Cross-Origin-Opener-Policy "same-origin"

# Old FTP-era .htaccess files must never become active: keep AllowOverride None.
